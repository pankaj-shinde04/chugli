# Backend production configuration
# Set these in the Render dashboard -> Service -> Environment Variables.
PORT=10000
MONGO_URI=your_mongodb_atlas_connection_string
# The production frontend origin (no trailing slash needed; backend strips it).
CORS_ORIGIN=https://chugli-rust.vercel.app
# Use a strong random secret in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace_with_a_strong_random_secret
